<%
  const learner =
    typeof user !== "undefined" &&
    user
      ? user
      : {};
  const gradeLabels = {
    10: "고등학교 1학년",
    11: "고등학교 2학년",
    12: "고등학교 3학년",
    13: "N수생",
  };
  const gradeLabel =
    gradeLabels[Number(learner.schoolGrade)] ||
    "학년 미설정";
  const assessmentCourses = Array.isArray(assessmentData?.courses)
    ? assessmentData.courses
    : [];
  const assessmentChoices = [];

  assessmentCourses.forEach((course) => {
    (course.units || []).forEach((unit) => {
      (unit.subunits || []).forEach((subunit) => {
        assessmentChoices.push({
          scopeType: "subunit",
          courseId: course.id,
          unitId: unit.id,
          subunitId: subunit.id,
          courseTitle: course.title,
          title: subunit.title,
          questionCount: 10,
          ...subunit,
        });
      });
      assessmentChoices.push({
        scopeType: "unit",
        courseId: course.id,
        unitId: unit.id,
        courseTitle: course.title,
        title: `${unit.title} 종합`,
        questionCount: 20,
        ...unit.final,
      });
    });
    assessmentChoices.push({
      scopeType: "course",
      courseId: course.id,
      courseTitle: course.title,
      title: `${course.title} 과목 종합평가`,
      questionCount: 40,
      ...course.courseFinal,
    });
  });

  const activeAssessment = assessmentChoices.find((item) => item.activeAttemptId);
  const nextAssessment = activeAssessment || assessmentChoices.find(
    (item) => item.unlocked && !item.passed
  );
  const availableCourseCount = assessmentCourses.filter((course) => course.available).length;
  const unlockedAssessmentCount = assessmentChoices.filter((item) => item.unlocked).length;
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="description"
      content="완료한 개념만으로 중간평가, 대단원 기말평가, 과목 종합평가에 응시하는 Matths 평가 센터입니다."
    />
    <title>평가 센터 | Matths</title>
    <link
      rel="stylesheet"
      href="/css/main.css"
    />
    <link
      rel="stylesheet"
      href="/css/assessment.css"
    />
    <script src="/js/main.js" defer></script>
    <script
      src="/js/assessment-center.js"
      defer
    ></script>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/images/favicon-64.png" />
    <link rel="stylesheet" href="/css/brand.css" />
    <link rel="stylesheet" href="/css/product-refresh.css" />
    <link rel="stylesheet" href="/css/assessment-center-v2.css" />
  </head>
  <body class="assessment-page">
    <a
      class="skip-link"
      href="#assessment-main"
    >
      본문으로 바로가기
    </a>

    <div class="dashboard-shell">
      <div class="sidebar-overlay" id="sidebar-overlay" hidden></div>

      <aside class="sidebar" id="dashboard-sidebar" aria-label="학습 메뉴">
        <div class="sidebar-top">
          <a class="brand" href="/" aria-label="Matths 메인">
            <%- include("partials/brand-primary-logo") %>
          </a>
          <button class="sidebar-close" id="sidebar-close" type="button" aria-label="메뉴 닫기">×</button>
        </div>

        <%- include("partials/dashboard-navigation", {
          activePage: "assessments",
        }) %>

        <div class="sidebar-spacer"></div>

        <div class="sidebar-profile">
          <a class="profile-avatar" href="/profile" aria-label="<%= learner.name || "학생" %>님의 프로필 설정으로 이동" title="프로필 설정"><%= String(learner.name || "학생").slice(0, 1) %></a>
          <div class="profile-copy">
            <strong><%= learner.name || "학생" %>님</strong>
            <small><%= gradeLabel %></small>
          </div>
          <form action="/logout" method="POST">
            <button type="submit" aria-label="로그아웃" title="로그아웃">↗</button>
          </form>
        </div>
      </aside>

      <main
        class="dashboard-main assessment-main"
        id="assessment-main"
      >
        <header class="topbar assessment-dashboard-topbar">
          <div class="topbar-left">
            <button
              class="sidebar-open"
              id="sidebar-open"
              type="button"
              aria-label="학습 메뉴 열기"
              aria-controls="dashboard-sidebar"
              aria-expanded="false"
            >
              <span></span><span></span><span></span>
            </button>
            <div>
              <p>평가 센터</p>
              <h1>전체 과목 평가</h1>
            </div>
          </div>
          <a class="back-dashboard learning-home-button" href="/main">학습 홈으로 <span aria-hidden="true">→</span></a>
        </header>

      <section class="assessment-command-center" aria-labelledby="assessment-command-title">
        <div class="assessment-command-copy">
          <p>평가 센터</p>
          <h2 id="assessment-command-title">지금 응시할 평가부터 확인하세요.</h2>
          <span>
            배운 개념만 시험 범위에 들어갑니다. 소단원 중간평가를 통과하면
            대단원, 과목 종합평가 순서로 열립니다.
          </span>
        </div>

        <dl class="assessment-command-metrics">
          <div><dt>통과 기준</dt><dd><%= assessmentData.passScore %><small>점</small></dd></div>
          <div><dt>열린 평가</dt><dd><%= unlockedAssessmentCount %><small>개</small></dd></div>
          <div><dt>열린 과목</dt><dd><%= availableCourseCount %><small>과목</small></dd></div>
        </dl>

        <aside class="assessment-next-action">
          <% if (nextAssessment) { %>
            <span><%= nextAssessment.activeAttemptId ? "진행 중인 평가" : "다음 응시 가능 평가" %></span>
            <strong><%= nextAssessment.title %></strong>
            <p><%= nextAssessment.courseTitle %> · <%= nextAssessment.questionCount %>문항 · 답안 자동 저장</p>
            <% if (nextAssessment.activeAttemptId) { %>
              <a href="/assessments/<%= nextAssessment.activeAttemptId %>">이어서 응시</a>
            <% } else { %>
              <form action="/assessments/start" method="post">
                <input type="hidden" name="scopeType" value="<%= nextAssessment.scopeType %>" />
                <input type="hidden" name="courseId" value="<%= nextAssessment.courseId %>" />
                <% if (nextAssessment.unitId) { %><input type="hidden" name="unitId" value="<%= nextAssessment.unitId %>" /><% } %>
                <% if (nextAssessment.subunitId) { %><input type="hidden" name="subunitId" value="<%= nextAssessment.subunitId %>" /><% } %>
                <button type="submit">평가 시작</button>
              </form>
            <% } %>
          <% } else { %>
            <span>다음 평가 준비</span>
            <strong>먼저 학습을 완료하세요.</strong>
            <p>개념 학습을 끝내면 해당 소단원 평가가 자동으로 열립니다.</p>
            <a href="/my-learning">학습 계속하기</a>
          <% } %>
        </aside>
      </section>

      <% assessmentData.courses.forEach((course, courseIndex) => { %>
        <details
          class="assessment-course <%= course.available ? 'available' : 'locked' %>"
          aria-labelledby="course-<%= course.id %>"
          <%= course.available ? "open" : "" %>
        >
          <summary class="course-heading">
            <div>
              <span>
                과목
                <%= String(courseIndex + 1).padStart(2, "0") %>
              </span>
              <h2 id="course-<%= course.id %>">
                <%= course.title %>
              </h2>
            </div>

            <div
              class="course-pass-state <%= course.courseFinal.passed ? 'passed' : '' %>"
            >
              <span>
                <%= course.available
                  ? `${course.unlockedAssessmentCount}개 평가 열림`
                  : "현재 응시 불가" %>
              </span>
              <strong>
                <%= course.courseFinal.passed
                  ? `과목 통과 · 최고 ${course.courseFinal.bestScore}점`
                  : course.available
                    ? "펼쳐서 평가 확인"
                    : "개념 학습 필요" %>
              </strong>
              <i aria-hidden="true">+</i>
            </div>
          </summary>

          <div class="assessment-course-body">
          <% if (!course.available) { %>
            <div class="locked-course-message">
              <span aria-hidden="true">⌁</span>
              <div>
                <h3>아직 이 과목의 평가에 응시할 수 없습니다.</h3>
                <p>
                  <%= course.lockReason %>
                  내 학습에서 이 과목의 개념을 모두 배우고 다시 오세요.
                </p>
                <a href="/my-learning">이 과목 학습하러 가기 →</a>
              </div>
            </div>
          <% } else { %>

          <div class="assessment-unit-list">
            <% course.units.forEach((unit, unitIndex) => { %>
              <article class="assessment-unit">
                <header>
                  <span>
                    <%= ["Ⅰ", "Ⅱ", "Ⅲ", "Ⅳ"][unitIndex] || unitIndex + 1 %>
                  </span>
                  <div>
                    <h3><%= unit.title %></h3>
                  </div>
                </header>

                <div class="subassessment-grid">
                  <% unit.subunits.forEach((subunit) => { %>
                    <div
                      class="subassessment-card <%= subunit.passed ? 'passed' : subunit.unlocked ? 'ready' : 'locked' %>"
                    >
                      <div class="assessment-state-icon" aria-hidden="true">
                        <%= subunit.passed ? "✓" : subunit.unlocked ? "→" : "·" %>
                      </div>

                      <div>
                        <span>소단원 중간평가 · 10문항</span>
                        <h4><%= subunit.title %></h4>
                        <p>
                          <%= subunit.activeAttemptId
                            ? "진행 중 · 작성한 답안 자동 저장"
                            : subunit.hasEmptyAttempt
                            ? "새 회차 준비 · 저장된 답안 없음"
                            : subunit.passed
                            ? `통과 · 최고 ${subunit.bestScore}점 · ${subunit.attempts}회 응시`
                            : subunit.attempts > 0
                            ? `미통과 · 최고 ${subunit.bestScore}점 · ${subunit.attempts}회 응시`
                            : subunit.unlocked
                              ? "응시 가능 · 중상 난이도"
                              : subunit.lockReason %>
                        </p>
                        <small>
                          <%= subunit.concepts
                            .map((concept) => concept.title)
                            .join(" · ") %>
                        </small>
                      </div>

                      <% if (subunit.activeAttemptId) { %>
                        <a
                          class="assessment-resume"
                          href="/assessments/<%= subunit.activeAttemptId %>"
                        >
                          이어서 응시
                        </a>
                      <% } else { %>
                        <form
                          action="/assessments/start"
                          method="post"
                        >
                        <input
                          type="hidden"
                          name="scopeType"
                          value="subunit"
                        />
                        <input
                          type="hidden"
                          name="courseId"
                          value="<%= course.id %>"
                        />
                        <input
                          type="hidden"
                          name="unitId"
                          value="<%= unit.id %>"
                        />
                        <input
                          type="hidden"
                          name="subunitId"
                          value="<%= subunit.id %>"
                        />
                        <button
                          type="submit"
                          <%= subunit.unlocked ? "" : "disabled" %>
                        >
                          <%= subunit.attempts > 0 || subunit.hasEmptyAttempt
                            ? "새 회차"
                            : "응시하기" %>
                        </button>
                        </form>
                      <% } %>
                    </div>
                  <% }) %>
                </div>

                <div
                  class="unit-final <%= unit.final.passed ? 'passed' : unit.final.unlocked ? 'ready' : 'locked' %>"
                >
                  <div>
                    <span>대단원 기말평가 · 20문항</span>
                    <h4>
                      <%= unit.title %> 종합
                    </h4>
                    <p>
                      중상 7문항 · 응용 8문항 · 심화 5문항
                    </p>
                  </div>

                  <div class="unit-final-action">
                    <strong>
                      <%= unit.final.activeAttemptId
                        ? "진행 중 · 작성한 답안 자동 저장"
                        : unit.final.hasEmptyAttempt
                        ? "새 회차 준비 · 저장된 답안 없음"
                        : unit.final.passed
                        ? `통과 · 최고 ${unit.final.bestScore}점`
                        : unit.final.attempts > 0
                        ? `미통과 · 최고 ${unit.final.bestScore}점`
                        : unit.final.unlocked
                          ? "응시 가능"
                          : unit.final.lockReason %>
                    </strong>
                    <% if (unit.final.activeAttemptId) { %>
                      <a
                        class="assessment-resume"
                        href="/assessments/<%= unit.final.activeAttemptId %>"
                      >
                        이어서 응시
                      </a>
                    <% } else { %>
                      <form
                        action="/assessments/start"
                        method="post"
                      >
                      <input
                        type="hidden"
                        name="scopeType"
                        value="unit"
                      />
                      <input
                        type="hidden"
                        name="courseId"
                        value="<%= course.id %>"
                      />
                      <input
                        type="hidden"
                        name="unitId"
                        value="<%= unit.id %>"
                      />
                      <button
                        type="submit"
                        <%= unit.final.unlocked ? "" : "disabled" %>
                      >
                        <%= unit.final.attempts > 0 || unit.final.hasEmptyAttempt
                          ? "새 회차"
                          : "기말평가 시작" %>
                      </button>
                      </form>
                    <% } %>
                  </div>
                  </div>
              </article>
            <% }) %>
          </div>

          <div
            class="course-final <%= course.courseFinal.passed ? 'passed' : course.courseFinal.unlocked ? 'ready' : 'locked' %>"
          >
            <div>
              <span>과목 종합평가 · 40문항</span>
              <h3>
                <%= course.title %> 과목 종합평가
              </h3>
              <p>
                과목 안에서 배운 개념과 응용·심화 문제를
                전 범위로 확인합니다.
              </p>
            </div>

            <div>
              <strong>
                <%= course.courseFinal.activeAttemptId
                  ? "진행 중 · 작성한 답안 자동 저장"
                  : course.courseFinal.hasEmptyAttempt
                  ? "새 회차 준비 · 저장된 답안 없음"
                  : course.courseFinal.passed
                  ? `통과 · 최고 ${course.courseFinal.bestScore}점`
                  : course.courseFinal.attempts > 0
                  ? `미통과 · 최고 ${course.courseFinal.bestScore}점`
                  : course.courseFinal.unlocked
                    ? "응시 가능"
                    : course.courseFinal.lockReason %>
              </strong>
              <% if (course.courseFinal.activeAttemptId) { %>
                <a
                  class="assessment-resume"
                  href="/assessments/<%= course.courseFinal.activeAttemptId %>"
                >
                  이어서 응시
                </a>
              <% } else { %>
                <form
                  action="/assessments/start"
                  method="post"
                >
                <input
                  type="hidden"
                  name="scopeType"
                  value="course"
                />
                <input
                  type="hidden"
                  name="courseId"
                  value="<%= course.id %>"
                />
                <button
                  type="submit"
                  <%= course.courseFinal.unlocked ? "" : "disabled" %>
                >
                  <%= course.courseFinal.attempts > 0 || course.courseFinal.hasEmptyAttempt
                    ? "새 회차"
                    : "종합평가 시작" %>
                </button>
                </form>
              <% } %>
            </div>
          </div>
          <% } %>
          </div>
        </details>
      <% }) %>
      </main>
    </div>
  </body>
</html>
