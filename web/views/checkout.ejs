<%
  const paymentsOpen =
    typeof checkoutEnabled !== "undefined" &&
    checkoutEnabled === true;
%>
<!doctype html>
<html lang="ko"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>결제 준비 | Matths</title><link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" /><link rel="stylesheet" href="/css/main.css" /><link rel="stylesheet" href="/css/public-navigation.css" /><link rel="stylesheet" href="/css/brand.css" /><link rel="stylesheet" href="/css/parent.css" /><link rel="stylesheet" href="/css/parent-v2.css" /></head>
<body class="checkout-page"><%- include('partials/public-navigation', { activePage: 'pricing', user }) %><main class="student-checkout-main"><section class="student-checkout-card"><p>본인 결제</p><h1><%= product.name %></h1><span><%= product.description %></span><dl><div><dt>이용 기간</dt><dd><%= product.periodLabel %></dd></div><div><dt>결제 예정 금액</dt><dd><strong><%= new Intl.NumberFormat('ko-KR').format(product.amount) %>원</strong></dd></div></dl>
<% if (!paymentsOpen) { %><div class="parent-pending-payment" role="status"><strong>유료 이용권 결제를 준비하고 있습니다.</strong><span>결제 기능이 열리기 전까지 별도 과금이나 유료 이용권 지급은 발생하지 않습니다. 무료 학습은 계속 이용할 수 있습니다.</span><a class="checkout-back" href="/my-learning">무료 학습 계속하기</a></div><% } else if (!intent) { %><form method="post"><label><input type="checkbox" required /> 상품과 금액을 확인했습니다.</label><button type="submit">결제 단계로 이동하기</button></form><% } else { %><div class="parent-pending-payment"><strong>결제할 내용을 마지막으로 확인해주세요.</strong><span>카드 정보는 결제사 화면에서만 입력하며 Matths 서버에 저장하지 않습니다.</span><button type="button" class="brand-action-primary" data-toss-checkout data-client-key="<%= paymentConfig.clientKey %>" data-customer-key="<%= paymentConfig.customerKey %>" data-order-id="<%= paymentConfig.orderId %>" data-order-name="<%= paymentConfig.orderName %>" data-amount="<%= paymentConfig.amount %>" data-success-url="<%= paymentConfig.successUrl %>" data-fail-url="<%= paymentConfig.failUrl %>">카드로 <%= new Intl.NumberFormat('ko-KR').format(paymentConfig.amount) %>원 결제하기</button><p data-payment-feedback role="status" aria-live="polite"></p></div><script src="https://js.tosspayments.com/v2/standard"></script><script src="/js/toss-checkout.js" defer></script><% } %><a class="checkout-back" href="/pricing">이용권 비교로 돌아가기</a></section></main></body></html>
