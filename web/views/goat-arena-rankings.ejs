<%
  const rankingUpdatedAt = ranking.latestCalculatedAt ? new Date(ranking.latestCalculatedAt) : null;
  const rankingUpdatedLabel = rankingUpdatedAt
    ? new Intl.DateTimeFormat("ko-KR", { timeZone: "Asia/Seoul", month: "long", day: "numeric", hour: "2-digit", minute: "2-digit" }).format(rankingUpdatedAt)
    : null;
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="description"
      content="GOAT Arena 스타일의 Unranked·Ranked 티어 랭킹"
    />
    <meta name="theme-color" content="#070913" />
    <title>랭킹 | GOAT Arena</title>
    <link rel="stylesheet" href="/css/goat-arena.css" />
    <%- include("partials/rank-motion-head") %>
    <link rel="stylesheet" href="/css/tier-rankings.css" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <script src="/js/goat-arena.js" defer></script>
    <script src="/js/tier-rankings.js" defer></script>
  </head>
  <body class="goat-arena-page arena-inner-page">
    <a class="arena-skip-link" href="#arena-rankings-main">본문으로 바로가기</a>

    <%- include("partials/goat-arena-navigation", {
      activeArenaPage,
      arenaUser,
    }) %>

    <main class="arena-page-main" id="arena-rankings-main">
      <header class="arena-page-heading arena-v2-page-heading">
        <div>
          <p>내 위치</p>
          <h1>티어 순위</h1>
        </div>
        <p>
          같은 티어에서 내 앞뒤 사용자를 먼저 확인하고, 필요할 때 전체 순위를 탐색하세요.
        </p>
      </header>

      <% if (ranking.current) { %>
        <section class="arena-v2-current-rank" aria-labelledby="current-rank-title">
          <div><small>현재 내 위치</small><h2 id="current-rank-title"><%= ranking.current.arenaRank %> <%= ranking.current.tierRank || ranking.current.arenaPosition || "—" %>위</h2><p><%= ranking.current.arenaDivision === "MAIN" ? "Ranked" : "Unranked" %> · <%= ranking.current.gp %> GP</p></div>
          <a class="arena-v2-secondary" href="#tier-ranking-pools">내 주변 순위로 이동</a>
        </section>
      <% } %>

      <section class="arena-final-ranking-panel" aria-labelledby="arena-final-ranking-title">
        <header>
          <div>
            <small>전체 모드 통합</small>
            <h2 id="arena-final-ranking-title">최종 종합 랭킹</h2>
          </div>
          <p>내부 실력 지표, 현재 Arena 성과와 이번 주 공식 모의고사 보너스를 정책 공식으로 계산한 전체 순위입니다.</p>
        </header>
        <div class="ranking-freshness" data-ranking-freshness data-updated-at="<%= rankingUpdatedAt ? rankingUpdatedAt.toISOString() : '' %>">
          <% if (rankingUpdatedLabel) { %><span>최근 공식 갱신 <strong><%= rankingUpdatedLabel %> KST</strong></span><% } %>
          <button type="button" data-ranking-retry>새로고침</button>
        </div>
        <% if (ranking.currentFinal) { %>
          <article class="arena-final-my-rank <%= ranking.currentFinal.hasMainProfileBorder ? 'has-main-shop-border' : '' %>">
            <div><small>나의 최종 종합 랭킹</small><strong><%= ranking.currentFinal.displayName %> <%- include("partials/arena-ranking-decoration", { decoration: ranking.currentFinal.rankingDecoration }) %></strong><span><%= ranking.currentFinal.division === "MAIN" ? "Ranked" : "Unranked" %></span></div>
            <dl><div><dt>전체 순위</dt><dd><%= ranking.currentFinal.finalRank %><small>위</small></dd></div><div><dt>최종 종합 점수</dt><dd><%= ranking.currentFinal.finalRating %></dd></div></dl>
          </article>
        <% } %>
        <div class="arena-final-ranking-scroll" data-ranking-scroll data-ranking-kind="final" data-current-school="<%= ranking.currentFinal?.schoolName || '' %>" tabindex="0" aria-label="최종 종합 랭킹 목록">
          <div class="arena-final-ranking-row arena-final-ranking-head"><span>순위</span><span>모드</span><span>플레이어</span><span>소속</span><span>최종 종합 점수</span></div>
          <% ranking.finalOverall.forEach((entry) => { const isCurrentRanker = entry.userId === String(user._id); %>
            <div class="arena-final-ranking-row <%= isCurrentRanker ? 'is-me' : '' %> <%= entry.hasMainProfileBorder ? 'has-main-shop-border' : '' %>" data-ranking-row data-rank="<%= entry.finalRank %>" data-name="<%= entry.displayName %>" data-division="<%= entry.division %>" data-school="<%= entry.affiliationName || '소속 미설정' %>" data-rank-delta="<%= entry.rankDelta || 0 %>" <% if (isCurrentRanker) { %>data-current-ranker aria-current="true"<% } %>><b><%= entry.finalRank %></b><span><%= entry.division === "MAIN" ? "Ranked" : "Unranked" %></span><strong><%= entry.displayName %><%= isCurrentRanker ? ' · 나' : '' %> <%- include("partials/arena-ranking-decoration", { decoration: entry.rankingDecoration }) %></strong><span><%= entry.affiliationName || '소속 미설정' %></span><em><%= entry.finalRating %><small class="ranking-delta <%= entry.rankDelta > 0 ? 'is-up' : entry.rankDelta < 0 ? 'is-down' : '' %>"><%= entry.rankDelta > 0 ? `▲${entry.rankDelta}` : entry.rankDelta < 0 ? `▼${Math.abs(entry.rankDelta)}` : '—' %></small></em></div>
          <% }) %>
        </div>
      </section>

      <%- include("partials/tier-ranking-pools", {
        ranking,
        user,
        rankingTheme: "ranking-theme-arena",
      }) %>
    </main>
  </body>
</html>
