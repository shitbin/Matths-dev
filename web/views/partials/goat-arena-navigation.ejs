<%
  const pendingRankUpPresentation =
    typeof rankUpPresentation !== "undefined"
      ? rankUpPresentation
      : null;
  const arenaNotificationState =
    typeof arenaNotifications !== "undefined"
      ? arenaNotifications
      : null;
  const arenaNavigationItems = [
    {
      key: "home",
      label: "홈",
      ariaLabel: "GOAT Arena 홈",
      href: "/goat-arena",
    },
    {
      key: "rankings",
      label: "티어 순위",
      ariaLabel: "GOAT Arena 티어 순위",
      href: "/goat-arena/rankings",
    },
    {
      key: "sub",
      label: "UNRANKED",
      ariaLabel: "Unranked 페이백 도전",
      href: "/goat-arena/sub",
      alertCount: arenaNotificationState?.actionByDivision?.SUB || arenaNotificationState?.defenseByDivision?.SUB || 0,
    },
    {
      key: "main",
      label: "RANKED",
      ariaLabel: "Ranked 상위 전장",
      href: "/goat-arena/main",
      alertCount: arenaNotificationState?.actionByDivision?.MAIN || arenaNotificationState?.defenseByDivision?.MAIN || 0,
    },
    {
      key: "shop",
      label: "상점",
      ariaLabel: "GOAT Arena Ranked 상점",
      href: "/goat-arena/main/shop",
    },
    {
      key: "rules",
      label: "경기 규정",
      ariaLabel: "GOAT Arena 경기 규정",
      href: "/goat-arena/rules/sub",
    },
  ];
  const mobileMatchHref = ["main", "shop"].includes(activeArenaPage)
    ? "/goat-arena/main"
    : "/goat-arena/sub";
%>
<header class="arena-hud">
  <a
    class="arena-brand"
    href="/goat-arena"
    aria-label="GOAT Arena 홈"
  >
    <img
      class="arena-brand-logo"
      src="/images/brand/matths-symbol.svg"
      alt=""
      width="44"
      height="44"
    />
    <span>
      <strong>GOAT Arena</strong>
      <small>Matths 수학 경쟁</small>
    </span>
  </a>

  <nav
    class="arena-main-navigation"
    aria-label="GOAT Arena 메뉴"
  >
    <% arenaNavigationItems.forEach((item) => { %>
      <a
        class="<%= activeArenaPage === item.key ? 'active' : '' %>"
        href="<%= item.href %>"
        aria-label="<%= item.ariaLabel %>"
        <% if (activeArenaPage === item.key) { %>aria-current="page"<% } %>
      ><%= item.label %><% if (item.alertCount) { %><b class="arena-nav-alert-count" aria-label="확인할 경기 <%= item.alertCount %>개"><%= item.alertCount > 9 ? "9+" : item.alertCount %></b><% } %></a>
    <% }) %>
  </nav>

  <nav class="arena-mobile-navigation" aria-label="GOAT Arena 모바일 메뉴">
    <a href="/goat-arena" <% if (activeArenaPage === "home") { %>aria-current="page" class="active"<% } %>>홈</a>
    <a href="<%= mobileMatchHref %>" <% if (["sub", "main"].includes(activeArenaPage)) { %>aria-current="page" class="active"<% } %>>경기</a>
    <a href="/goat-arena/rankings" <% if (activeArenaPage === "rankings") { %>aria-current="page" class="active"<% } %>>순위</a>
    <button type="button" aria-expanded="false" aria-controls="arena-mobile-more" data-arena-mobile-more-toggle>더보기</button>
    <div id="arena-mobile-more" class="arena-mobile-more-panel" hidden data-arena-mobile-more-panel>
      <a href="/goat-arena/sub">Unranked</a>
      <a href="/goat-arena/main">Ranked</a>
      <a href="/goat-arena/main/shop">Ranked 상점</a>
      <a href="/goat-arena/rules/sub">경기 규정</a>
      <a href="/goat-arena/profile">Arena 프로필</a>
      <a href="/main">Matths 대시보드</a>
    </div>
  </nav>

  <div class="arena-account">
    <a
      class="arena-dashboard-link"
      href="/main"
    >Matths 대시보드</a>
    <div class="arena-mailbox <%= activeArenaPage === 'mailbox' ? 'active' : '' %>" data-arena-mailbox>
      <button
        class="arena-mailbox-button"
        type="button"
        aria-label="GOAT Arena 우편함<%= arenaNotificationState?.unreadCount ? `, 읽지 않은 알림 ${arenaNotificationState.unreadCount}개` : '' %>"
        aria-expanded="false"
        data-arena-mailbox-toggle
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3.5 6.5h17v11h-17zM4 7l8 6 8-6" /></svg>
        <% if (arenaNotificationState?.unreadCount) { %><b><%= arenaNotificationState.unreadCount > 99 ? "99+" : arenaNotificationState.unreadCount %></b><% } %>
      </button>
      <section class="arena-mailbox-panel" aria-label="최근 알림" hidden data-arena-mailbox-panel>
        <header><strong>우편함</strong><a href="/goat-arena/mailbox">전체 보기</a></header>
        <% if (!arenaNotificationState?.notifications?.length) { %>
          <p>도착한 알림이 없습니다.</p>
        <% } %>
        <% arenaNotificationState?.notifications?.forEach((notification) => { %>
          <a class="arena-mailbox-item <%= notification.unread ? 'is-unread' : '' %> <%= notification.tone ? `is-${notification.tone}` : '' %>" href="<%= notification.href %>">
            <strong><%= notification.title %></strong>
            <span><%= notification.message %></span>
          </a>
        <% }) %>
      </section>
    </div>
    <a
      class="arena-player <%= activeArenaPage === 'profile' ? 'active' : '' %> <%= arenaUser.hasMainProfileBorder ? 'has-main-shop-border' : '' %>"
      href="/goat-arena/profile"
      aria-label="<%= arenaUser.nickname %>님의 GOAT Arena 프로필"
      <% if (activeArenaPage === "profile") { %>aria-current="page"<% } %>
    >
      <span aria-hidden="true"><%= arenaUser.nickname.slice(0, 1) %></span>
      <strong>
        <%= arenaUser.nickname %>
        <% if (arenaUser.hasStyleEntrance) { %><small>출전 연출 적용</small><% } %>
      </strong>
    </a>
  </div>
</header>
<% if (pendingRankUpPresentation) { %>
  <%- include("rank-motion-dialog", {
    rankMotionAssetBase: "/media/rank-motion",
    rankMotionMode: "modal",
    rankMotionBackdrop: true,
    rankMotionControls: true,
  }) %>
  <script type="application/json" data-rank-up-presentation-payload><%- JSON.stringify(pendingRankUpPresentation).replace(/</g, "\\u003c") %></script>
<% } %>
<script src="/js/session-usage.js" defer></script>
<script src="/js/goat-arena-navigation.js" defer></script>
