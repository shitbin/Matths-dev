<%
  const storyState = curriculumStory || { story: null, status: "unavailable" };
  const story = storyState.story;
  const kindLabels = {
    intuition: "직관",
    question: "질문",
    misconception: "오개념",
    solution: "풀이 리듬",
    recall: "회상",
  };
  const kindSymbols = {
    intuition: "●",
    question: "?",
    misconception: "!",
    solution: "→",
    recall: "↺",
  };
  const studentStoryJson = story
    ? JSON.stringify(story)
        .replace(/</g, "\\u003c")
        .replace(/>/g, "\\u003e")
        .replace(/&/g, "\\u0026")
    : "";
  const narrationScope = String(
    typeof curriculumNarrationScope === "string"
      ? curriculumNarrationScope
      : "anonymous"
  );
%>

<section
  class="curriculum-memory"
  aria-labelledby="curriculum-memory-title"
  data-curriculum-story-status="<%= storyState.status %>"
  <% if (story) { %>data-curriculum-story-id="<%= story.id %>"<% } %>
>
  <header class="curriculum-memory-heading">
    <div>
      <p>풀이 기억선</p>
      <h3 id="curriculum-memory-title">
        <%= story ? story.title : "5분 해설은 편집 중입니다" %>
      </h3>
      <span>
        <%= story
          ? story.openingQuestion
          : "검수된 원고가 준비되기 전에는 자동으로 만든 해설을 보여주지 않습니다."
        %>
      </span>
    </div>

    <% if (story) { %>
      <div class="curriculum-narration-controls">
        <button
          type="button"
          class="curriculum-narration-toggle"
          data-curriculum-narration-toggle
          aria-describedby="curriculum-narration-status"
        >
          <span aria-hidden="true">▶</span>
          <b>5분 해설 듣기</b>
        </button>
        <button
          type="button"
          class="curriculum-narration-restart"
          data-curriculum-narration-restart
          hidden
        >
          처음부터
        </button>
        <p
          id="curriculum-narration-status"
          class="curriculum-narration-status"
          data-curriculum-narration-status
          aria-live="polite"
        >
          기기의 한국어 여성 음성을 우선 사용합니다.
        </p>
      </div>
    <% } %>
  </header>

  <% if (story) { %>
    <ol class="curriculum-memory-line">
      <% story.scenes.forEach((scene) => { %>
        <li
          class="curriculum-memory-beat"
          data-memory-kind="<%= scene.kind %>"
          data-memory-scene-id="<%= scene.id %>"
        >
          <span class="curriculum-memory-node" aria-hidden="true">
            <%= kindSymbols[scene.kind] || "·" %>
          </span>
          <article>
            <p><%= kindLabels[scene.kind] || "장면" %></p>
            <h4><%= scene.title %></h4>
            <strong><%= scene.subtitle %></strong>
            <details>
              <summary>해설 원문 읽기</summary>
              <p><%= scene.narration %></p>
            </details>
          </article>
        </li>
      <% }) %>
    </ol>
    <script
      type="application/json"
      id="curriculum-narration-data"
      data-checkpoint-scope="<%= narrationScope %>"
    ><%- studentStoryJson %></script>
  <% } else { %>
    <div class="curriculum-memory-unavailable" role="status">
      <span aria-hidden="true">◇</span>
      <div>
        <strong>기존 개념 학습은 그대로 이어갈 수 있습니다.</strong>
        <p>
          아래 핵심 설명과 시각 학습, 연습 문제를 이용해 주세요.
          검수를 마친 해설만 이 기억선에 추가됩니다.
        </p>
      </div>
    </div>
  <% } %>
</section>
