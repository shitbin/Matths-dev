<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= heading %> | Matths</title><link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png"><link rel="stylesheet" href="/css/main.css"><link rel="stylesheet" href="/css/public-navigation.css"><link rel="stylesheet" href="/css/matths-brand-tokens.css"><link rel="stylesheet" href="/css/brand.css"><link rel="stylesheet" href="/css/parent.css"><link rel="stylesheet" href="/css/parent-v2.css"></head>
<body><%- include('partials/public-navigation', { activePage: 'pricing', user: null }) %><main class="student-checkout-main"><section class="student-checkout-card" role="status" aria-live="polite"><p><%= success ? '결제 완료' : (uncertain ? '결제 확인 중' : '결제 확인') %></p><h1><%= heading %></h1><span><%= message %></span><% if (success && paymentSummary) { %><dl class="payment-result-summary"><div><dt>상품</dt><dd><%= paymentSummary.orderName %></dd></div><div><dt>결제 금액</dt><dd><%= new Intl.NumberFormat('ko-KR').format(paymentSummary.amount) %>원</dd></div><div><dt>승인 시각</dt><dd><%= paymentSummary.approvedAt ? new Intl.DateTimeFormat('ko-KR', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(paymentSummary.approvedAt)) : '승인 완료' %></dd></div><div><dt>주문번호</dt><dd><%= paymentSummary.orderId %></dd></div></dl><% if (paymentSummary.receiptUrl) { %><a class="checkout-back" href="<%= paymentSummary.receiptUrl %>" target="_blank" rel="noopener noreferrer">결제 영수증 보기</a><% } %><% } %><div class="payment-result-actions"><a class="brand-action-primary" href="<%= primaryHref %>"><%= primaryLabel %></a><a href="/">홈으로 돌아가기</a></div></section></main></body></html>
