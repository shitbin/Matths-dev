<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>학부모 로그인 | Matths</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="stylesheet" href="/css/brand.css" />
    <link rel="stylesheet" href="/css/parent.css" />
    <link rel="stylesheet" href="/css/parent-v2.css" />
  </head>
  <body class="parent-auth-page">
    <a class="matths-skip-link" href="#parent-login-main">로그인으로 바로가기</a>
    <main class="parent-auth-shell" id="parent-login-main">
      <a class="parent-auth-brand" href="/parent" aria-label="Matths 학부모 대시보드"><%- include("partials/brand-primary-logo") %></a>
      <section class="parent-auth-card parent-login-card">
        <p>학부모 계정</p><h1>학부모 로그인</h1><span>연결된 자녀의 학습 현황과 이용 상태를 확인합니다.</span>
        <% if (error) { %><div class="parent-form-message is-error" role="alert"><%= error %></div><% } %>
        <form method="post" action="/parent/login" class="parent-auth-form">
          <input type="hidden" name="next" value="<%= next %>" />
          <label><span>학부모 아이디 또는 이메일</span><input name="identifier" value="<%= oldInput.identifier %>" autocomplete="username" required /></label>
          <label><span>비밀번호</span><input type="password" name="password" autocomplete="current-password" required /></label>
          <button type="submit">로그인</button>
        </form>
        <small class="parent-auth-meta">학부모 계정은 자녀가 보낸 결제 요청 이메일의 링크에서 만들 수 있습니다.</small>
      </section>
    </main>
  </body>
</html>
