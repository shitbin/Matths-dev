# 서버에서만 사용하는 MongoDB 접속 문자열입니다.
# iPad 앱, 브라우저 번들, Git 저장소에 넣지 마세요.
DB=mongodb+srv://USER:PASSWORD@HOST/DATABASE

# 웹 세션과 API 토큰은 서로 다른 긴 무작위 키를 사용하세요.
SECRET=replace-with-at-least-32-random-characters
API_TOKEN_SECRET=replace-with-another-32-random-characters
API_TOKEN_TTL_SECONDS=2592000

# 서버 공개 주소와 포트
BIND_HOST=0.0.0.0
# 운영 배포에서만 설정. listen 주소가 아니라 사용자에게 공개되는 HTTPS 기준 URL이다.
PUBLIC_BASE_URL=https://matths.kr
PORT=8000
NODE_ENV=development

# Google OAuth 웹·iPad 공통 설정. Google Console에는 이 redirect URI 하나만 등록합니다.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://matths.kr/auth/google/callback

# 결제 공급자 승인·검증·이용권 지급 경계가 완성되기 전에는 반드시 0입니다.
# 1/true로 설정한 경우에만 결제 준비 데이터와 학부모 결제 요청을 허용합니다.
PAYMENT_CHECKOUT_ENABLED=0
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 운영자 계정과 비밀번호 인증코드 발신자
ADMIN_EMAIL=admin@lsbproduction.com

# 현재 구현은 Gmail SMTP를 사용합니다. 일반 비밀번호가 아니라 2단계 인증 뒤
# 발급한 16자리 앱 비밀번호를 사용합니다. 발신 주소를 다르게 쓰려면 Gmail에서
# 먼저 별칭을 인증해야 합니다.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Matths
PASSWORD_RESET_SECRET=replace-with-another-32-random-characters
